{
    "comments": {
        // symbol used for single line comment. Remove this entry if your language does not support line comments
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    // symbols used as brackets
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["<", ">"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}",
            "notIn": [
                "string",
                "comment"
            ]
        },
        {
            "open": "[",
            "close": "]",
            "notIn": [
                "string",
                "comment"
            ]
        },
        {
            "open": "(",
            "close": ")",
            "notIn": [
                "string",
                "comment"
            ]
        },
        {
            "open": "'",
            "close": "'",
            "notIn": [
                "string",
                "comment"
            ]
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": [
                "string"
            ]
        },
        {
            "open": "/*",
            "close": " */",
            "notIn": [
                "string"
            ]
        }
    ],
    // symbols that can be used to surround a selection
    // "surroundingPairs": [
    //     ["{", "}"],
    //     ["[", "]"],
    //     ["(", ")"],
    //     ["\"", "\""],
