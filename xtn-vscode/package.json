{
  "name": "xtn",
  "publisher": "xtn-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/koustubhmoharir/xtn"
  },
  "displayName": "xtn",
  "description": "Language Support for the XTN format",
  "version": "0.1.2",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./dist/client/extension",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xtn",
        "aliases": [
          "xtn",
          "xtn"
        ],
        "extensions": [
          ".xtn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xtn",
        "scopeName": "source.xtn",
        "path": "./syntaxes/xtn.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "awatch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "lint": "eslint ./client/src ./server/src --ext .ts,.tsx",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
    "test": "sh ./scripts/e2e.sh",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.0",
    "@types/node": "^16.11.7",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.35.0",
    "mocha": "^9.2.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.0.2"
  }
}
