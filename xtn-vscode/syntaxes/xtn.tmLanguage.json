{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "xtn",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#value"
		}
	],
	"repository": {
		"array": {
			"begin": "\\[",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.array.begin.xtn"
				}
			},
			"end": "\\]",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.array.end.xtn"
				}
			},
			"name": "meta.structure.array.xtn",
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#value"
				},
				{
					"match": ",",
					"name": "punctuation.separator.array.xtn"
				},
				{
					"match": "[^\\s\\]]",
					"name": "invalid.illegal.expected-array-separator.xtn"
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"match": "/{2}.*",
					"name": "comment.single.xtn"
				},
				{
					"begin": "/\\*\\*(?!/)",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.xtn"
						}
					},
					"end": "\\*/",
					"name": "comment.block.documentation.xtn"
				},
				{
					"begin": "/\\*",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.xtn"
						}
					},
					"end": "\\*/",
					"name": "comment.block.xtn"
				}
			]
		},
		"constant": {
			"match": "\\b(?:true|false|null|Infinity|NaN)\\b",
			"name": "constant.language.xtn"
		},
		"infinity": {
			"match": "(-)*\\b(?:Infinity|NaN)\\b",
			"name": "constant.language.xtn"
		},
		"key": {
			"name": "string.key.xtn",
			"patterns": [
				{
					"include": "#stringSingle"
				},
				{
					"include": "#stringDouble"
				},
				{
					"match": "[a-zA-Z0-9_-]",
					"name": "string.key.xtn"
				}
			]
		},
		"number": {
			"patterns": [
				{
					"comment": "handles hexadecimal numbers",
					"match": "(0x)[0-9a-fA-f]*",
					"name": "constant.hex.numeric.xtn"
				},
				{
					"comment": "handles integer and decimal numbers",
					"match": "[+-.]?(?=[1-9]|0(?!\\d))\\d+(\\.\\d+)?([eE][+-]?\\d+)?",
					"name": "constant.dec.numeric.xtn"
				}
			]
		},
		"object": {
			"begin": "\\{",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.dictionary.begin.xtn"
				}
			},
			"comment": "xtn object",
			"end": "\\}",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.dictionary.end.xtn"
				}
			},
			"name": "meta.structure.dictionary.xtn",
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"comment": "the xtn object key",
					"include": "#key"
				},
				{
					"begin": ":",
					"beginCaptures": {
						"0": {
							"name": "punctuation.separator.dictionary.key-value.xtn"
						}
					},
					"end": "(,)|(?=\\})",
					"endCaptures": {
						"1": {
							"name": "punctuation.separator.dictionary.pair.xtn"
						}
					},
					"name": "meta.structure.dictionary.value.xtn",
					"patterns": [
						{
							"comment": "the xtn object value",
							"include": "#value"
						},
						{
							"match": "[^\\s,]",
							"name": "invalid.illegal.expected-dictionary-separator.xtn"
						}
					]
				},
				{
					"match": "[^\\s\\}]",
					"name": "invalid.illegal.expected-dictionary-separator.xtn"
				}
			]
		},
		"stringDouble": {
			"begin": "[\"]",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.string.begin.xtn"
				}
			},
			"end": "[\"]",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.string.end.xtn"
				}
			},
			"name": "string.quoted.xtn",
			"patterns": [
				{
					"match": "(?x:                # turn on extended mode\n                     \\\\                # a literal backslash\n                     (?:               # ...followed by...\n                       [\"\\\\/bfnrt]     # one of these characters\n                       |               # ...or...\n                       u               # a u\n                       [0-9a-fA-F]{4}  # and four hex digits\n                     )\n                   )",
					"name": "constant.character.escape.xtn"
				},
				{
					"match": "\\\\.",
					"name": "invalid.illegal.unrecognized-string-escape.xtn"
				}
			]
		},
		"stringSingle": {
			"begin": "[']",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.string.begin.xtn"
				}
			},
			"end": "[']",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.string.end.xtn"
				}
			},
			"name": "string.quoted.xtn",
			"patterns": [
				{
					"match": "(?x:                # turn on extended mode\n                     \\\\                # a literal backslash\n                     (?:               # ...followed by...\n                       [\"\\\\/bfnrt]     # one of these characters\n                       |               # ...or...\n                       u               # a u\n                       [0-9a-fA-F]{4}  # and four hex digits\n                     )\n                   )",
					"name": "constant.character.escape.xtn"
				},
				{
					"match": "\\\\.",
					"name": "invalid.illegal.unrecognized-string-escape.xtn"
				}
			]
		},
		"value": {
			"comment": "the 'value' diagram at http://json.org",
			"patterns": [
				{
					"include": "#constant"
				},
				{
					"include": "#infinity"
				},
				{
					"include": "#number"
				},
				{
					"include": "#stringSingle"
				},
				{
					"include": "#stringDouble"
				},
				{
					"include": "#array"
				},
				{
					"include": "#object"
				}
			]
		}
	},
	"scopeName": "source.xtn"
}