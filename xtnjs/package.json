  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.3",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.13.1",
    "lodash": "^4.17.21",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
